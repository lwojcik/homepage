---
import { ClientRouter } from 'astro:transitions';
import '../styles/site.css';
import '../styles/pages.css';
import Nav from '../components/Nav.astro';
import Social from '../components/Social.astro';
import { social } from '../data/site';

interface Props { title: string; description: string; current: string; dock?: boolean; image?: string; plain?: boolean }
const { title, description, current, dock = true, image = '/assets/img/og.png', plain = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const site = Astro.site!.href;
const personId = `${site}#person`;
// One linked graph: who the site is about (Person), the site itself (WebSite) and this page (WebPage / ProfilePage on the home page).
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person', '@id': personId, name: 'Łukasz Wójcik', url: site,
      jobTitle: 'Software engineer, photographer', description: 'Software engineer and documentary photographer based in Poland.',
      image: new URL('/assets/img/photo.jpg', Astro.site).href,
      knowsAbout: ['TypeScript', 'React', 'Node.js', 'NestJS', 'Photography'],
      sameAs: [...social.map((s) => s.href), 'https://lukaszwojcik.photo/', 'https://www.npmjs.com/~lwojcik', 'https://glass.photo/lukaszwojcik', 'https://500px.com/p/lwojcik'],
    },
    { '@type': 'WebSite', '@id': `${site}#website`, url: site, name: 'Łukasz Wójcik', inLanguage: 'en', publisher: { '@id': personId } },
    {
      '@type': Astro.url.pathname === '/' ? 'ProfilePage' : 'WebPage', '@id': `${canonical}#page`, url: canonical, name: title, description,
      isPartOf: { '@id': `${site}#website` }, ...(Astro.url.pathname === '/' ? { mainEntity: { '@id': personId } } : { about: { '@id': personId } }),
    },
  ],
};
---
<!doctype html>
<html lang="en" data-plain={plain ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="me" href="https://hachyderm.io/@lukem" />

    <!-- What search engines and link previews read: every page has its own title, description and image. -->
    <meta property="og:type" content={Astro.url.pathname === '/' ? 'profile' : 'website'} />
    {Astro.url.pathname === '/' && <><meta property="profile:first_name" content="Łukasz" /><meta property="profile:last_name" content="Wójcik" /></>}
    <meta property="og:site_name" content="Łukasz Wójcik" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Łukasz Wójcik, software engineer and photographer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Łukasz Wójcik, software engineer and photographer" />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    <!-- Source Sans 3 is self-hosted; preload it so text never flashes in another font. -->
    <link rel="preload" href="/assets/fonts/source-sans-3-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/source-sans-3-latin-ext.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline src="/assets/site-head.js"></script>
    <noscript><style>body { opacity: 1 !important; }</style></noscript>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <!-- Everything the living background draws goes here. transition:persist keeps it (and the avatar) alive
         while you move between pages. -->
    <div id="avatar-layer" transition:persist="avatar-layer"></div>
    <main>
      {
        plain ? (
          <nav class="plain-nav" aria-label="Back to the site">
            <a href="/">← lukaszwojcik.net</a>
          </nav>
        ) : (
          <Nav current={current} />
        )
      }
      <!-- Only this block cross-fades between pages (see site.css); the menu and the panel stay put. -->
      <div class="page" id="content" tabindex="-1">
        <slot />
        {dock && <Social />}
      </div>
    </main>
    <p class="copyright">© 2009–{new Date().getFullYear()}</p>
    {
      import.meta.env.DEV ? (
        <>
          <script is:inline src="/assets/site.js" />
          <script is:inline src="/assets/avatar-live.js" />
          <script is:inline src="/assets/live-config.js" />
        </>
      ) : (
        <script is:inline src="/assets/app.js" />
      )
    }
  </body>
</html>
